# ==============================================================================
# FenixCMS SaaS — Variables de Entorno de Ejemplo
# ==============================================================================
# Copie este archivo a .env.local para desarrollo local:
#   cp .env.example .env.local
# IMPORTANTE: Nunca exponga ni guarde credenciales reales en el repositorio.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENTORNO Y APLICACIÓN
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="FenixCMS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dominio raíz para la plataforma SaaS (en prod: fenixcms.com)
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (PostgreSQL)
# ------------------------------------------------------------------------------
# Cadena de conexión para Prisma ORM
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/fenixcms_db?schema=public"
# Cadena directa para migraciones (opcional si se usa connection pooling)
DIRECT_URL="postgresql://postgres:postgres_password@localhost:5432/fenixcms_db?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTENTICACIÓN, SESIONES Y SEGURIDAD
# ------------------------------------------------------------------------------
# Clave secreta para firma y cifrado de tokens (mínimo 32 caracteres)
AUTH_SECRET="change-this-to-a-secure-random-32-character-secret"
AUTH_COOKIE_DOMAIN=".fenixcms.local"
SESSION_MAX_AGE_SECONDS=86400

# Semilla inicial para el Superadministrador (solo primer arranque de bootstrap)
SUPERADMIN_BOOTSTRAP_EMAIL="superadmin@fenixcms.local"

# ------------------------------------------------------------------------------
# 4. PASARELA DE PAGOS (PayPal)
# ------------------------------------------------------------------------------
# Modo: sandbox o live
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id_here"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret_here"
PAYPAL_WEBHOOK_ID="your_paypal_webhook_id_here"

# ------------------------------------------------------------------------------
# 5. SERVICIO DE CORREO (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your_smtp_username_here"
SMTP_PASS="your_smtp_password_here"
SMTP_FROM="FenixCMS <no-reply@fenixcms.local>"

# ------------------------------------------------------------------------------
# 6. ALMACENAMIENTO DE ARCHIVOS Y MULTIMEDIA
# ------------------------------------------------------------------------------
# local | s3
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./public/uploads"
STORAGE_BUCKET="fenixcms-media"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# ------------------------------------------------------------------------------
# 7. INTERNACIONALIZACIÓN (I18N)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_LOCALE="es"
NEXT_PUBLIC_SUPPORTED_LOCALES="es,en,fr,it,pt,de,ht"
