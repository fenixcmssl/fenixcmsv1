generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SuperAdmin {
  id         String   @id @default(cuid())
  name       String
  lastName   String?
  email      String   @unique
  password   String
  phone      String?
  nie        String?
  cif        String?
  address    String?
  logoUrl    String?
  faviconUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GlobalSetting {
  id                 String   @id @default("global")
  platformName       String   @default("FenixCMS Cloud Engine")
  supportEmail       String   @default("admin@fenixcms.io")
  baseCurrency       String   @default("EUR")
  defaultLanguage    String   @default("es")
  trialDays          Int      @default(14)
  defaultTax         Float    @default(21.0)
  stripeEnabled      Boolean  @default(true)
  paypalEnabled      Boolean  @default(true)
  bizumEnabled       Boolean  @default(true)
  autoSsl            Boolean  @default(true)
  allowRegistrations Boolean  @default(true)
  maintenanceMode    Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  operator  String
  details   Json?
  createdAt DateTime @default(now())
}

model Tenant {
  id                  String             @id @default(cuid())
  name                String
  email               String?            
  password            String?
  moduleType          String
  currency            String             @default("EUR")
  language            String             @default("es")
  color               String             @default("#000000")
  themeColor          String             @default("#000000")
  logoUrl             String?
  status              String             @default("ACTIVE")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tenantDomains       TenantDomain[]
  subscriptions       Subscription[]
  ecommerceProducts   EcommerceProduct[]
  ecommerceCategories ProductCategory[]
  properties          Property[]
  auctionItems        AuctionItem[]
}

model TenantDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isCustom  Boolean  @default(false)
  sslStatus String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Application {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("ECOMMERCE")
  version   String   @default("1.0.0")
  status    String   @default("ACTIVA")
  desc      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String?  @unique
  monthlyPrice Float
  yearlyPrice  Float
  trialDays    Int?     @default(14)
  tag          String?
  appName      String?
  desc         String?
  features     Json?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Subscription {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId      String
  status      String   @default("ACTIVE")
  nextBilling DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductCategory {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  imageUrl    String?
  parentId    String?
  products    EcommerceProduct[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EcommerceProduct {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  // Datos Generales
  name            String
  slug            String?
  description     String?
  shortDesc       String?
  imageUrl        String?
  galleryUrls     String[] 
  
  // Precios e Impuestos
  price           Float
  salePrice       Float?
  taxStatus       String   @default("TAXABLE")
  taxClass        String?
  
  // Inventario
  sku             String?
  manageStock     Boolean  @default(false)
  stock           Int      @default(0)
  lowStockAmount  Int      @default(2)
  backorders      String   @default("NO")
  stockStatus     String   @default("IN_STOCK")
  
  // Envío (Logística)
  weight          Float?
  length          Float?
  width           Float?
  height          Float?
  shippingClass   String?
  
  // Vinculados y Atributos
  upSellIds       String[]
  crossSellIds    String[]
  attributes      Json?    
  
  // Estado y Relaciones
  isActive        Boolean  @default(true)
  status          String   @default("PUBLISHED")
  categoryId      String?
  category        ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variations      ProductVariation[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProductVariation {
  id              String   @id @default(cuid())
  productId       String
  product         EcommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sku             String?
  price           Float
  salePrice       Float?
  manageStock     Boolean  @default(false)
  stock           Int      @default(0)
  lowStockAmount  Int      @default(2)
  stockStatus     String   @default("IN_STOCK")
  weight          Float?
  length          Float?
  width           Float?
  height          Float?
  
  attributes      Json     
  imageUrl        String?
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Property {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  price       Float
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuctionItem {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startingBid Float
  currentBid  Float?
  endTime     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
